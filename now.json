{
  "version": 2,
  "github": {
    "enabled": true
  },
  "builds": [
    {
      "src": "next.config.js",
      "use": "@now/next"
    }
  ],
  "routes": [
    {
      "src": "/categorias/(.*)",
      "status": 301,
      "headers": {
        "Location": "/$1"
      }
    }
  ],
  "build": {
    "env": {
      "ACCESS_TOKEN": "@access-token"
    }
  }
}
