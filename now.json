{
    "version": 2,
    "builds": [
        {
            "src": "next.config.js",
            "use": "@now/next"
        }
    ],
    "routes": [
        {
            "src": "/preview",
            "dest": "/preview"
        },
        {
            "src": "/(?<uid>[^/]+)$",
            "dest": "/post?uid=$uid"
        },
        {
            "src": "categorias/(?<uid>[^/]+)$",
            "dest": "/archive?uid=$uid"
        }
    ]
}