{
    "version": 2,
    "name": "Garitma",
    "alias": [
        "garitma.com"
    ],
    "builds": [
        {
            "src": "next.config.js",
            "use": "@now/next"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "status": 301,
            "headers": {
                "Location": "https://garitma.com/$1"
            }
        }
    ]
}